# Bind address and port (used by the container command; uvicorn flags locally)
CV_HOST=0.0.0.0
CV_PORT=8000

# Minimum YOLO confidence for a detection to be returned (0-1)
CONFIDENCE_THRESHOLD=0.25

# YOLO weights: a local .pt path, or a known model name downloaded on first use
MODEL_PATH=yolo11n.pt
